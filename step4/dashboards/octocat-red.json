{
  "annotations": {"list": []},
  "editable": true,
  "schemaVersion": 39,
  "title": "octocat-supply — RED Dashboard",
  "tags": ["octocat", "victoriametrics"],
  "time": {"from": "now-30m", "to": "now"},
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "env",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "victoriametrics"},
        "query": "label_values(http_requests_total, env)",
        "current": {"text": "poc-aks", "value": "poc-aks"},
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1, "title": "Request Rate (RPS) by status",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {"expr": "sum by (status) (rate(http_requests_total{env=\"$env\"}[1m]))", "legendFormat": "{{status}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "id": 2, "title": "Error Ratio (%)",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {"expr": "100 * sum(rate(http_requests_total{env=\"$env\",status=~\"4..|5..\"}[5m])) / sum(rate(http_requests_total{env=\"$env\"}[5m]))", "legendFormat": "error%"}
      ],
      "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "red", "value": 5}]}}}
    },
    {
      "id": 3, "title": "Total RPS",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {"expr": "sum(rate(http_requests_total{env=\"$env\"}[1m]))", "legendFormat": "rps"}
      ],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "id": 4, "title": "Latency p50 / p95 / p99 (ms)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {"expr": "1000*histogram_quantile(0.50, sum by (le)(rate(http_request_duration_seconds_bucket{env=\"$env\"}[5m])))", "legendFormat": "p50"},
        {"expr": "1000*histogram_quantile(0.95, sum by (le)(rate(http_request_duration_seconds_bucket{env=\"$env\"}[5m])))", "legendFormat": "p95"},
        {"expr": "1000*histogram_quantile(0.99, sum by (le)(rate(http_request_duration_seconds_bucket{env=\"$env\"}[5m])))", "legendFormat": "p99"}
      ],
      "fieldConfig": {"defaults": {"unit": "ms"}}
    },
    {
      "id": 5, "title": "Process Memory (RSS MB)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {"expr": "process_resident_memory_bytes{env=\"$env\"}/1024/1024", "legendFormat": "rss"}
      ],
      "fieldConfig": {"defaults": {"unit": "decmbytes"}}
    },
    {
      "id": 6, "title": "Event Loop Lag (ms)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 8},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {"expr": "1000*nodejs_eventloop_lag_mean_seconds{env=\"$env\"}", "legendFormat": "lag"}
      ],
      "fieldConfig": {"defaults": {"unit": "ms"}}
    }
  ]
}
